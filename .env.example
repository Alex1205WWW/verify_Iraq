# --- Database -------------------------------------------------------------
# SQLite by default so the MVP runs with no external services.
# For Postgres: change provider to "postgresql" in prisma/schema.prisma and
# point this at your instance.
DATABASE_URL="file:./dev.db"

# --- Session --------------------------------------------------------------
# Any long random string. Sessions are signed with it.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- WhatsApp Cloud API ---------------------------------------------------
# Leave these blank and assignment offers run in DRY RUN: the message is
# logged and written to the offer row, and the admin can simulate the
# researcher's Accept/Decline from the task screen. Fill them in and the
# same code path sends a real template message.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="task_offer"
WHATSAPP_TEMPLATE_LANG="en"
# Token you invent, then enter in Meta's webhook configuration screen.
WHATSAPP_VERIFY_TOKEN="verify-me"
